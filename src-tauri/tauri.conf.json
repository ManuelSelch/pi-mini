{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Floating Spike",
  "version": "0.1.0",
  "identifier": "com.piagent.floating-spike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pi Floating Spike",
        "width": 340,
        "height": 300,
        "minWidth": 280,
        "minHeight": 240,
        "center": true,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "shadow": true,
        "backgroundColor": "#181b22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
