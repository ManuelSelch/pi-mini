{
  "name": "pi-mini-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:host && tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:host": "esbuild src/conversation/infra/host/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-host/main.mjs",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:host && npm run build:web",
    "build:native": "npm run build && tauri build --debug --no-bundle",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:application && npm run test:ui",
    "test:application": "tsx --test ../tests/companion/conversation.scenarios.test.mjs tests/conversation/app/*.test.ts tests/conversation/infra/*.test.ts",
    "test:ui": "vitest run",
    "test:native": "node --test tests/native/startup.test.mjs",
    "test:model": "node tests/native/model-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.3",
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-codemode": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-mcp": "1.0.3",
    "@earendil-works/pi-telemetry": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@manuelselch/pi-sdk": "0.2.1",
    "@manuelselch/pi-server": "0.2.1",
    "@tabler/icons-react": "3.50.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-websocket": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.1",
    "jsdom": "29.0.1",
    "tailwindcss": "4.3.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0",
    "ws": "8.21.3"
  }
}
