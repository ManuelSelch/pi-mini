{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Mini",
  "version": "0.1.0",
  "identifier": "com.piagent.mini",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "Pi Mini",
      "width": 360,
      "height": 380,
      "minWidth": 360,
      "minHeight": 380,
      "maxWidth": 360,
      "maxHeight": 380,
      "center": true,
      "decorations": false,
      "resizable": false,
      "maximizable": false,
      "alwaysOnTop": true,
      "transparent": true,
      "backgroundColor": "#00000000"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"]
  }
}
