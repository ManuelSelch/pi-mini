  "entry": ["tests/**/*.{ts,tsx,mjs}", "scripts/*.mjs"],
  "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.{ts,tsx,mjs}", "scripts/*.mjs"],
  "ignoreDependencies": [
    "@earendil-works/chord",
